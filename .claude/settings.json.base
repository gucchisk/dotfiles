{
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        ".",
        "~/.cache",
        "~/.local/share",
        "/tmp",
        "/private/tmp",
        "/var/folders",
        "/Library/Caches",
        "~/Library/Caches",
        "~/.claude",
        "~/.claude.json",
        "~/.claude.json.backup",
        "~/.claude.json.lock",
        "~/.claude.lock",
        "~/.serena",
        ".serena",
        "/dev/tty",
        "~/.m2/repository",
        "~/.m2/wrapper",
        "~/go/pkg/mod",
        "~/go/bin"
      ]
    },
     "network": {
      "allowedDomains": [
        "api.github.com",
        "*.githubusercontent.com",
        "github.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Read"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(chmod 777 *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify.sh"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "teammateMode": "tmux",
  "alwaysThinkingEnables": false,
  "statusLine": {
    "type": "command",
    "command": "npx -y ccusage statusline",
    "padding": 0
  }
}
